rules_version = '2';

// OmniField Pro — regras do Firestore (projeto omnifield-pro)
//
// Modelo: Firebase Authentication (e-mail/senha) com E-MAIL CONFIRMADO obrigatório.
// - O administrador é quem tem o e-mail abaixo CONFIRMADO (o mesmo de ADMIN_EMAIL em
//   src/services/firebase.js). Ninguém consegue "assumir" o sistema sem controlar essa caixa.
// - Os demais usuários têm perfil em users/{uid} e só acessam dados com status 'approved'.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Dono do sistema: e-mail do administrador, confirmado.
    function isOwner() {
      return verified()
        && request.auth.token.email == 'eletrica@3darcondicionado.com.br';
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Perfil aprovado + e-mail confirmado.
    function isApproved() {
      return isOwner() || (verified() && hasProfile() && profile().status == 'approved');
    }

    function isAdmin() {
      return isOwner() || (isApproved() && profile().role == 'administrador');
    }

    match /users/{uid} {
      // Cada pessoa lê o próprio perfil (para saber se foi aprovada); aprovados leem todos.
      allow read: if signedIn() && (request.auth.uid == uid || isApproved());

      // Cadastro: a própria pessoa cria o perfil como "pendente". O dono do sistema
      // (e-mail confirmado) pode criar o próprio perfil já como administrador.
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'usuario'
          && request.resource.data.status == 'pending_approval')
        || (isOwner()
          && request.resource.data.role == 'administrador'
          && request.resource.data.status == 'approved')
      );

      // Atualização:
      //  - o dono do sistema altera qualquer perfil (é o único que concede/retira administrador);
      //  - demais administradores aprovam/recusam e ajustam cargo e diária, mas não mexem em
      //    perfil de acesso (role), e-mail ou identificadores;
      //  - a própria pessoa edita só dados pessoais (nunca role, status, diária, e-mail, ids).
      allow update: if isOwner()
        || (isAdmin()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'email', 'uid', 'id']))
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'status', 'dailyRate', 'email', 'uid', 'id']));

      // Exclusão: o dono do sistema nunca é excluído; administradores só são removidos pelo dono.
      allow delete: if resource.data.email != 'eletrica@3darcondicionado.com.br'
        && (isOwner() || (isAdmin() && resource.data.role != 'administrador'));
    }

    // Dados financeiros e de cadastro das obras: somente o administrador grava.
    match /obras/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
    match /purchase_orders/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Operação de campo: qualquer usuário aprovado.
    match /quadros/{docId} {
      allow read, write: if isApproved();
    }
    match /cards/{docId} {
      allow read, write: if isApproved();
    }
    match /checklists/{docId} {
      allow read, write: if isApproved();
    }
    match /field_reports/{docId} {
      allow read, write: if isApproved();
    }
    match /notifications/{docId} {
      allow read, write: if isApproved();
    }
    match /chat_messages/{docId} {
      allow read, write: if isApproved();
    }
    match /dimensionamentos/{docId} {
      allow read, write: if isApproved();
    }
    match /calculos_quadros/{docId} {
      allow read, write: if isApproved();
    }
  }
}
